# NEXXOS Backend - Variables de entorno (PLANTILLA)
# Copia este archivo a .env y rellena con valores reales. NUNCA subas .env a git.

DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=<genera-un-secreto-fuerte>
AWS_REGION=us-east-1
AWS_BUCKET_NAME=<nombre-del-bucket>
AWS_FOLDER_PREFIX=
EMAIL_USER=<correo>
EMAIL_PASSWORD=<clave-del-correo>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
SKIP_EMAIL_VERIFICATION=false
ABACUSAI_API_KEY=<api-key>
RESEND_API_KEY=<resend-api-key>
CONFIG_ENCRYPTION_KEY=<clave-hex-32-bytes>
S3_ACCESS_KEY_ID=<access-key>
S3_SECRET_ACCESS_KEY=<secret-key>
CRON_SECRET=<secreto-para-endpoints-cron>
GOOGLE_PLACES_API_KEY=<google-places-key-restringida>
