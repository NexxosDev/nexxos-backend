# NEXXOS Frontend (Expo) - Variables de entorno (PLANTILLA)
# Copia este archivo a .env y rellena con valores reales. NUNCA subas .env a git.
# NOTA: las variables EXPO_PUBLIC_* se incrustan en el bundle público de la app.
#       Protege las claves restringiéndolas por package-id / bundle-id en su consola.

EXPO_PUBLIC_API_URL=https://tu-backend.example.com/
EXPO_PUBLIC_SKIP_EMAIL_VERIFICATION=false
EXPO_PUBLIC_GOOGLE_MAPS_KEY=<google-maps-static-key-restringida>
